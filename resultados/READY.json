 "como_instanciar": {
  "docker_run": "sudo docker run -d --name cerise26_gen3d_srv --gpus all --ipc=host -v ~/cerise2026/hf_cache:/root/.cache/huggingface -v ~/cerise2026/gen3d/hy3dgen_models:/opt/gen3d/hy3dgen_models -p 127.0.0.1:8095:8095 cerise26_gen3d:latest <comando do servidor>",
  "python": "import sys; sys.path.insert(0, '/opt/gen3d/pipeline'); from gen3d_pipeline import Gen3DPipeline; pipe = Gen3DPipeline(); out = pipe.generate('/caminho/foto.jpg', '/tmp/saida', preset='padrao')",
  "observacoes": [
   "HY3DGEN_MODELS=/opt/gen3d/hy3dgen_models (arvore de links para o cache HF + UNet do paint convertido para .bin)",
   "carregar so os presets necessarios: Gen3DPipeline(presets={k: DEFAULT_PRESETS[k] for k in ['rapido','padrao']}) evita carregar o paint completo do 'alto'",
   "a imagem limita o alocador a 24 GB (gpu_cap_gb); conferir free -g (>= 10 GB livres alem do modelo) antes de subir, pois a producao (vLLM) divide a memoria unificada",
   "nao expor a porta fora do loopback: exposicao publica e decisao pendente do Eduardo"
  ]
 },
