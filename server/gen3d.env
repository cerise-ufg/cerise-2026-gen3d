# Configuracao do servidor de geracao 3D (sem segredos; chaves de API, se usadas, vao em gen3d.secrets.env fora do git)
GEN3D_DATA_DIR=/data
GEN3D_PRESETS=rapido,padrao,alto
GEN3D_PRIORITY_OFFSETS=rapido:0,padrao:30,alto:90
GEN3D_EST_SECONDS=rapido:24,padrao:30,alto:82
GEN3D_JOB_TIMEOUTS=rapido:240,padrao:300,alto:600
GEN3D_MAX_QUEUE=32
GEN3D_MAX_QUEUED_PER_CLIENT=4
GEN3D_RATE_JOBS_PER_MIN=6
GEN3D_RATE_JOBS_BURST=6
GEN3D_RATE_READS_PER_MIN=1200
GEN3D_RATE_READS_BURST=200
GEN3D_RETENTION_DAYS=7
GEN3D_DELETE_INPUT_AFTER_PROCESSING=1
GEN3D_CACHE=1
# a versao do pipeline entra na chave do cache: trocar sempre que a saida mudar (v2: textura JPEG de fato, 26/10)
GEN3D_PIPELINE_VERSION=hy2turbo-a3-v2-jpeg
GEN3D_LEGACY_PRESET=rapido
GEN3D_WORKER_PRESETS=rapido,padrao,alto
GEN3D_WARMUP_PRESETS=rapido,alto
GEN3D_GPU_CAP_GB=24
GEN3D_MIN_AVAILABLE_GB=10
GEN3D_CORS_ORIGINS=https://cerise.wenfur.com.br,http://localhost:8081,http://localhost:19006
HF_MODULES_CACHE=/tmp/hf_modules
HF_HUB_OFFLINE=1
# cache do numba (pymatting/rembg) em tmpfs: um desligamento abrupto do Spark corrompeu o cache gravado em
# dist-packages/__pycache__ e o worker entrou em loop de reinicio; em tmpfs ele e recriado limpo a cada start
NUMBA_CACHE_DIR=/tmp/numba_cache
